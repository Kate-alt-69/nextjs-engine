{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["engine", "index.ts", "server.tsx"],
	"exclude": ["node_modules"]
}
