{
	"name": "nextjs-engine",
	"version": "2.6.2",
	"private": false,
	"scripts": {
		"build": "npm run type-check && next build",
		"dev": "next dev",
		"start": "next start",
		"type-check": "tsc --noEmit",
		"test:browser": "playwright test",
		"clear": "pwsh -Command \"clear; Remove-Item ./.next, ./dist, -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item tsconfig.tsbuildinfo -Force -ErrorAction SilentlyContinue\""
	},
	"dependencies": {
		"next": "^16.3.3",
		"next-view-transitions": "^0.3.5",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"three": "^0.184.0",
		"two.js": "^0.8.23"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@types/node": "^20.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/three": "^0.185.0",
		"typescript": "^5.3.0"
	}
}
